{
  "experiments": {
    "scaled_attention_core": {
      "description": "Scaled tensor benchmark for the paper's sparse autoregressive attention claim. Reference values encode dense-attention fidelity and the paper's 90% target sparsity setting.",
      "weight": 0.7,
      "primary_metric": "mean_relative_l2_error",
      "metrics": {
        "mean_relative_l2_error": {
          "higher_is_better": false,
          "coefficient": 1.0
        },
        "mean_cosine_similarity": {
          "higher_is_better": true,
          "coefficient": 0.5
        },
        "active_block_fraction": {
          "higher_is_better": false,
          "coefficient": -0.5
        },
        "dense_equivalent_fraction": {
          "higher_is_better": false,
          "coefficient": -0.1
        }
      },
      "results": {
        "dense_reference": {
          "type": "baseline",
          "mean_relative_l2_error": 0.0,
          "mean_cosine_similarity": 1.0,
          "active_block_fraction": 1.0,
          "dense_equivalent_fraction": 1.0
        },
        "light_forcing": {
